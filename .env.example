# ===========================================
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# For different environments, use .env.staging, .env.prod, etc.

# ===========================================
# Application URLs
# ===========================================
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# ===========================================
# Authentication
# ===========================================
AUTH_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=testpass

# ===========================================
# Test Configuration
# ===========================================
# Test environment: local, dev, staging, prod
TEST_ENV=local
# Default timeout in milliseconds
DEFAULT_TIMEOUT=60000
# Number of retries for flaky tests
TEST_RETRIES=0
# Parallel workers count
WORKERS=1

# ===========================================
# API Configuration
# ===========================================
API_VERSION=v1
API_TIMEOUT=30000

# ===========================================
# Database (if needed for test data setup)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=postgres
DB_PASSWORD=postgres

# ===========================================
# Reporting
# ===========================================
ALLURE_RESULTS_PATH=./tests/reports/allure-results
ALLURE_REPORT_PATH=./tests/reports/allure-report
HTML_REPORT_PATH=./tests/reports/html
JUNIT_REPORT_PATH=./tests/reports/junit

# ===========================================
# CI/CD Configuration
# ===========================================
CI=false
# Slack webhook URL for test failure notifications
SLACK_WEBHOOK_URL=