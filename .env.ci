# ===========================================
# CI/CD Environment Configuration
# ===========================================
# This file is used by CI/CD pipelines (GitHub Actions, Jenkins)
# Copy this to .env.ci and configure for your CI environment
# ===========================================
# IMPORTANT: Never commit real secrets to version control!
# Use CI/CD secret management (GitHub Secrets, Jenkins Credentials)
# for sensitive values like passwords and tokens.
# ===========================================

# ===========================================
# Application URLs
# ===========================================
# Override these via CI/CD secrets for different environments
BASE_URL=https://staging.example.com
API_BASE_URL=https://staging.example.com/api

# ===========================================
# Authentication (CI-specific)
# ===========================================
# Use CI/CD secrets to inject these values
AUTH_TOKEN=
ADMIN_USERNAME=ci-admin
ADMIN_PASSWORD=ci-admin-password
TEST_USER_USERNAME=ci-testuser
TEST_USER_PASSWORD=ci-testpass

# ===========================================
# Test Configuration
# ===========================================
# Test environment: dev, staging, prod
TEST_ENV=staging
# Default timeout in milliseconds (60s for CI)
DEFAULT_TIMEOUT=60000
# Number of retries for flaky tests (2 retries in CI)
TEST_RETRIES=2
# Parallel workers count (50% of CPU cores in CI)
WORKERS=4

# ===========================================
# API Configuration
# ===========================================
API_VERSION=v1
API_TIMEOUT=30000

# ===========================================
# Reporting
# ===========================================
ALLURE_RESULTS_PATH=./tests/reports/allure-results
ALLURE_REPORT_PATH=./tests/reports/allure-report
HTML_REPORT_PATH=./tests/reports/html
JUNIT_REPORT_PATH=./tests/reports/junit

# ===========================================
# CI/CD Configuration
# ===========================================
# Set to true when running in CI/CD pipeline
CI=true
# Slack webhook URL for test failure notifications
# Set this via CI/CD secrets, not in this file
SLACK_WEBHOOK_URL=

# ===========================================
# GitHub Actions Specific
# ===========================================
# These are automatically set by GitHub Actions
# GITHUB_ACTIONS=true
# GITHUB_RUN_ID=
# GITHUB_RUN_NUMBER=
# GITHUB_SHA=
# GITHUB_REF=
# GITHUB_REPOSITORY=
# GITHUB_ACTOR=
# GITHUB_WORKFLOW=
# GITHUB_EVENT_NAME=
# GITHUB_WORKSPACE=

# ===========================================
# Jenkins Specific
# ===========================================
# These are automatically set by Jenkins
# JENKINS_HOME=
# JENKINS_URL=
# BUILD_NUMBER=
# BUILD_ID=
# BUILD_URL=
# JOB_NAME=
# JOB_BASE_NAME=
# NODE_NAME=
# WORKSPACE=
# BRANCH_NAME=