{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "@playwright/test"],
    "baseUrl": ".",
    "paths": {
      "@tests/*": ["tests/*"],
      "@utils/*": ["tests/utils/*"],
      "@config/*": ["tests/config/*"],
      "@pages/*": ["tests/e2e/pages/*"],
      "@api/*": ["tests/api/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@types/*": ["tests/types/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/reports"
  ]
}